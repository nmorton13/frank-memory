    "agents": "^0.33.0",
    "jose": "6.2.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "private": true,
  "type": "module"
}
